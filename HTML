
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>JUNIOR FX PRO</title>
<style>
* { box-sizing: border-box; }
body {
  margin: 0;
  background: #080a0f;
  color: #f5f5f5;
  font-family: Arial, sans-serif;
}
header {
  padding: 22px 16px;
  text-align: center;
  border-bottom: 1px solid #292929;
}
.logo {
  color: #d9b44a;
  font-size: 28px;
  font-weight: 900;
  letter-spacing: 2px;
}
.subtitle { color: #999; font-size: 12px; }
main { max-width: 600px; margin: auto; padding: 20px; }
.card {
  background: #12151d;
  border: 1px solid #292d38;
  border-radius: 14px;
  padding: 18px;
  margin-bottom: 18px;
}
h2 { font-size: 17px; color: #e1bd5b; }
label {
  display: block;
  margin: 14px 0 6px;
  font-size: 13px;
  color: #c6c6c6;
}
input, select {
  width: 100%;
  padding: 13px;
  background: #090b10;
  color: white;
  border: 1px solid #343946;
  border-radius: 8px;
  font-size: 15px;
}
.status {
  padding: 14px;
  background: #090b10;
  border-radius: 8px;
  color: #f0c95a;
  overflow-wrap: anywhere;
}
button {
  width: 100%;
  padding: 15px;
  border: 0;
  border-radius: 9px;
  font-size: 15px;
  font-weight: bold;
  cursor: pointer;
  margin-top: 12px;
}
.start { background: #d9b44a; color: #101010; }
.stop { background: #292d38; color: white; }
.note {
  color: #aaa;
  font-size: 12px;
  line-height: 1.6;
}
footer { text-align: center; color: #666; padding: 20px; font-size: 12px; }
</style>
</head>

<body>
<header>
  <div class="logo">JUNIOR FX PRO</div>
  <p class="subtitle">AUTOMATED TRADING DASHBOARD</p>
</header>

<main>
  <div class="card">
    <h2>01 / BROKER SETTINGS</h2>

    <label for="broker">Broker</label>
    <select id="broker">
      <option value="HFM">HFM</option>
      <option value="Exness">Exness</option>
      <option value="XM">XM</option>
      <option value="Other">Other</option>
    </select>

    <label for="server">MT5 server name</label>
    <input id="server" placeholder="e.g. your broker's MT5 server">

    <label for="account">MT5 account number (optional)</label>
    <input id="account" inputmode="numeric"
      placeholder="Use demo details only for now">

    <label for="mode">Account mode</label>
    <select id="mode">
      <option value="Demo">DEMO — practice account</option>
      <option value="Live">LIVE — real money</option>
    </select>

    <p class="note">
      This page does not connect to your broker yet. Do not enter your
      password, investor password, API key, or other secret credentials.
    </p>
  </div>

  <div class="card">
    <h2>02 / TRADING CONFIGURATION</h2>

    <label for="symbol">Trading symbol</label>
    <select id="symbol">
      <option value="XAUUSD">XAUUSD — Gold</option>
      <option value="NAS100">NAS100 — Nasdaq</option>
      <option value="BTCUSD">BTCUSD — Bitcoin</option>
    </select>

    <label for="lots">Lot size</label>
    <select id="lots">
      <option value="0.01">0.01 — smallest setting</option>
      <option value="0.02">0.02</option>
      <option value="0.05">0.05</option>
    </select>

    <label for="risk">Trading risk</label>
    <select id="risk">
      <option value="low">Conservative — demo testing</option>
      <option value="medium">Moderate — demo testing</option>
    </select>
  </div>

  <div class="card">
    <h2>03 / ENGINE CONTROL</h2>

    <p class="note">Dashboard status:</p>
    <div class="status" id="status" role="status">
      ENGINE STOPPED — MT5 NOT CONNECTED
    </div>

    <button class="start" id="start">▶ START ENGINE</button>
    <button class="stop" id="stop">■ STOP ENGINE</button>

    <p class="note" id="message">
      Start Engine only updates this dashboard. It cannot start real trades
      until a secure connection to your MT5 Expert Advisor is built.
    </p>
  </div>

  <div class="card">
    <h2>04 / CONNECTION CHECK</h2>
    <p class="note">Website: <span style="color:#e1bd5b">ONLINE</span></p>
    <p class="note">Broker connection: NOT CONNECTED</p>
    <p class="note">MT5 robot: NOT CONNECTED</p>
    <p class="note">Trade execution: DISABLED</p>
  </div>

  <footer>
    JUNIOR FX PRO · Trade with discipline.<br>
    Trading involves risk. Profits are not guaranteed.
  </footer>
</main>

<script>
const statusBox = document.getElementById("status");
const message = document.getElementById("message");

document.getElementById("start").addEventListener("click", function () {
  const broker = document.getElementById("broker").value;
  const mode = document.getElementById("mode").value;
  const symbol = document.getElementById("symbol").value;
  const lots = document.getElementById("lots").value;

  statusBox.textContent = "START REQUESTED — MT5 CONNECTION REQUIRED";
  message.textContent =
    "Selected: " + broker + " | " + mode + " | " + symbol +
    " | Lot size " + lots +
    ". No trade was placed. Connect and test the MT5 EA before enabling execution.";
});

document.getElementById("stop").addEventListener("click", function () {
  statusBox.textContent = "DASHBOARD STOPPED — MT5 CONNECTION NOT AVAILABLE";
  message.textContent =
    "The dashboard has stopped its local start request. This button cannot close or stop trades in MT5 until the real connection is implemented.";
});
</script>
</body>
</html>
