
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#080a0e">
<title>JUNIOR FX PRO MAX</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#080a0e;color:#f4f4f4;font:15px Arial,sans-serif}
header{padding:22px 16px;text-align:center;border-bottom:1px solid #292d35}
.logo{font-size:27px;font-weight:900;letter-spacing:2px;color:#e5bd52}
.sub{color:#9ca3af;font-size:11px;letter-spacing:2px;margin-top:7px}
main{max-width:760px;margin:auto;padding:15px}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.card{background:#12161e;border:1px solid #292e39;border-radius:13px;padding:16px;margin-bottom:13px;min-width:0}
.full{grid-column:1/-1}
h2{font-size:14px;color:#e5bd52;margin:0 0 15px}
label{display:block;color:#adb3c0;font-size:12px;margin:12px 0 6px}
input,select{width:100%;padding:12px;background:#090c12;color:white;border:1px solid #343b48;border-radius:7px;font-size:14px}
.stat{font-size:19px;font-weight:bold;margin-top:8px;overflow-wrap:anywhere}
.small{font-size:11px;color:#9ca3af;line-height:1.6}
.gold{color:#e5bd52}
.status{padding:12px;background:#090c12;border-radius:8px;color:#f2cb61;font-size:12px;line-height:1.6;overflow-wrap:anywhere}
button{border:0;border-radius:8px;padding:14px;font-weight:bold;cursor:pointer;width:100%;margin-top:9px}
.start{background:#e5bd52;color:#101010}
.stop{background:#343945;color:white}
.clear{background:#242a34;color:#eee}
.item{padding:10px 0;border-bottom:1px solid #292d35;font-size:12px;color:#bbc1cc}
.item:last-child{border:0}
footer{text-align:center;padding:22px;color:#747b87;font-size:11px}
@media(max-width:420px){.grid{grid-template-columns:1fr}.full{grid-column:auto}.logo{font-size:23px}}
</style>
</head>
<body>
<header>
  <div class="logo">JUNIOR FX PRO MAX</div>
  <div class="sub">AUTOMATED TRADING CONTROL CENTRE</div>
</header>

<main>
<div class="grid">

<section class="card">
<h2>01 · ENGINE STATUS</h2>
<div class="small">Dashboard state</div>
<div class="stat gold" id="engine">STOPPED</div>
<p class="small" id="connection">MT5 connection: Not connected</p>
<div class="status" id="notice">Demo mode recommended. No trades can be placed from this page alone.</div>
<button class="start" id="start">▶ START ENGINE</button>
<button class="stop" id="stop">■ STOP ENGINE</button>
</section>

<section class="card">
<h2>02 · ACCOUNT OVERVIEW</h2>
<div class="small">Broker</div><div class="stat" id="accountBroker">HFM</div>
<div class="small">Account mode</div><div class="stat" id="accountMode">DEMO</div>
<div class="small">Account number</div><div class="stat" id="accountNumber">Not entered</div>
<p class="small">Balance, equity and margin require a real MT5 connection.</p>
</section>

<section class="card full">
<h2>03 · BROKER CONNECTION</h2>
<label for="broker">Broker</label>
<select id="broker"><option>HFM</option><option>Exness</option><option>XM</option><option>Other</option></select>
<label for="server">MT5 server name</label>
<input id="server" placeholder="Enter the exact MT5 server name">
<label for="account">MT5 account number</label>
<input id="account" inputmode="numeric" placeholder="Demo account recommended">
<label for="mode">Account type</label>
<select id="mode"><option value="DEMO">DEMO — practice only</option><option value="LIVE">LIVE — real money</option></select>
<p class="small">Never enter your trading password here. This page does not yet connect to a broker.</p>
</section>

<section class="card full">
<h2>04 · TRADING CONFIGURATION</h2>
<label for="symbol">Market</label>
<select id="symbol"><option>XAUUSD</option><option>NAS100</option><option>BTCUSD</option></select>
<label for="timeframe">Chart timeframe</label>
<select id="timeframe"><option>M1</option><option>M5</option><option>M15</option><option>H1</option></select>
<label for="lots">Lot size</label>
<select id="lots"><option>0.01</option><option>0.02</option><option>0.05</option></select>
<label for="risk">Risk profile</label>
<select id="risk"><option value="LOW">Conservative</option><option value="MEDIUM">Moderate</option></select>
<label for="maxTrades">Maximum open trades (intended limit)</label>
<select id="maxTrades"><option>1</option><option>2</option><option>3</option></select>
<label for="dailyLoss">Daily loss limit (account currency)</label>
<input id="dailyLoss" type="number" min="1" value="5">
<p class="small">These are saved dashboard settings, not active broker-side risk controls. The connected EA must independently enforce every limit.</p>
</section>

<section class="card">
<h2>05 · MARKET WATCH</h2>
<div class="item">XAUUSD <span class="gold">Gold</span></div>
<div class="item">NAS100 <span class="gold">Nasdaq</span></div>
<div class="item">BTCUSD <span class="gold">Bitcoin</span></div>
<p class="small">Live prices appear after a market-data connection is added.</p>
</section>

<section class="card">
<h2>06 · TRADE MONITOR</h2>
<div class="small">Open trades</div><div class="stat">—</div>
<div class="small">Floating profit/loss</div><div class="stat">—</div>
<div class="small">Last signal</div><div class="stat">—</div>
<p class="small">No live trading data connected.</p>
</section>

<section class="card full">
<h2>07 · ACTIVITY LOG</h2>
<div id="log" class="item">Dashboard loaded. MT5 is not connected.</div>
<button class="clear" id="save">SAVE DASHBOARD SETTINGS</button>
<button class="clear" id="reset">RESET DASHBOARD</button>
<p class="small">Settings are stored only in this browser when local storage is available. Do not use this page on a shared device for sensitive account information.</p>
</section>

<section class="card full">
<h2>08 · CONNECTION CHECKLIST</h2>
<div class="item">Website interface: <span class="gold">READY</span></div>
<div class="item">Broker connection: NOT CONNECTED</div>
<div class="item">MT5 Expert Advisor: NOT CONNECTED</div>
<div class="item">Live prices and trade history: NOT CONNECTED</div>
<div class="item">Automated execution: DISABLED</div>
</section>
</div>

<footer>
JUNIOR FX PRO MAX · Discipline before profit.<br>
Trading can cause losses. No profit is guaranteed.
</footer>
</main>

<script>
const $ = id => document.getElementById(id);
const fields = ["broker","server","account","mode","symbol","timeframe","lots","risk","maxTrades","dailyLoss"];

function log(message){
  $("log").textContent = new Date().toLocaleString() + " — " + message;
}
function updateAccount(){
  $("accountBroker").textContent = $("broker").value;
  $("accountMode").textContent = $("mode").value;
  $("accountNumber").textContent = $("account").value || "Not entered";
}
fields.forEach(id => $(id).addEventListener("change",updateAccount));

$("start").addEventListener("click",()=>{
  if($("mode").value === "LIVE"){
    $("engine").textContent = "BLOCKED";
    $("notice").textContent = "Live trading is disabled until a secure MT5 connection and broker-side risk controls are implemented.";
    log("Live start blocked: no MT5 connection.");
    return;
  }
  $("engine").textContent = "REQUESTED";
  $("connection").textContent = "MT5 connection: Not connected";
  $("notice").textContent = "Start request recorded locally only. No order was sent and the EA is not running.";
  log("Demo start requested for " + $("symbol").value + ". No order sent.");
});

$("stop").addEventListener("click",()=>{
  $("engine").textContent = "STOP REQUESTED";
  $("notice").textContent = "Dashboard request stopped locally. This cannot stop an EA or close MT5 trades without a real connection.";
  log("Local stop requested. MT5 state unchanged.");
});

$("save").addEventListener("click",()=>{
  try{
    const data={};
    fields.forEach(id=>data[id]=$(id).value);
    localStorage.setItem("juniorFxSettings",JSON.stringify(data));
    updateAccount();
    log("Dashboard settings saved in this browser.");
  }catch(e){
    log("Browser storage unavailable. Settings were not saved.");
  }
});

$("reset").addEventListener("click",()=>{
  if(!confirm("Reset dashboard fields?")) return;
  fields.forEach(id=>{
    if(id==="broker") $(id).value="HFM";
    else if(id==="mode") $(id).value="DEMO";
    else if(id==="symbol") $(id).value="XAUUSD";
    else if(id==="timeframe") $(id).value="M1";
    else if(id==="lots") $(id).value="0.01";
    else if(id==="risk") $(id).value="LOW";
    else if(id==="maxTrades") $(id).value="1";
    else if(id==="dailyLoss") $(id).value="5";
    else $(id).value="";
  });
  $("engine").textContent="STOPPED";
  $("notice").textContent="Dashboard reset. MT5 is not connected.";
  updateAccount();
  log("Dashboard reset.");
});

try{
  const saved=JSON.parse(localStorage.getItem("juniorFxSettings")||"null");
  if(saved) fields.forEach(id=>{if(saved[id]!==undefined) $(id).value=saved[id];});
}catch(e){}
updateAccount();
</script>
</body>
</html>
